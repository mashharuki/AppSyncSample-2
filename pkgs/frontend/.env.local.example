# AWS AppSync Configuration
# CDKデプロイ後、以下の値を設定してください

# AppSync GraphQL Endpoint URL
# `pnpm cdk run deploy '*'` 実行後、出力される GraphQLAPIURL の値
NEXT_PUBLIC_APPSYNC_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxx.appsync-api.ap-northeast-1.amazonaws.com/graphql

# AppSync API Key
# CDKデプロイ後、出力される GraphQLAPIKey の値
NEXT_PUBLIC_APPSYNC_API_KEY=da2-xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region
NEXT_PUBLIC_AWS_REGION=ap-northeast-1
